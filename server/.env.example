# --- Supabase / PostgreSQL ---
# Runtime uses the Transaction pooler (port 6543, pgbouncer=true).
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrations use the Direct connection (port 5432).
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Local alternative (Prisma Dev)
# DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# --- Auth.js v5 ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-strong-random-secret"
AUTH_TRUST_HOST=true

# --- Gemini (Phase 2 Synthesis Agent) ---
# Leave empty to use the deterministic local fallback blueprint.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# --- Payments ---
# true: in-memory mock PaymentIntents/transfers (no Stripe credentials needed)
# false: real Stripe REST calls (requires STRIPE_SECRET_KEY)
USE_MOCK_PAYMENTS=true
MOCK_PAYMENT_FAILURE_RATE=0
STRIPE_SECRET_KEY=""
STRIPE_CONNECTED_ACCOUNT_ID=""
STRIPE_CURRENCY="usd"

# --- Server ---
PORT=3001
CLIENT_ORIGIN="http://localhost:5173"
