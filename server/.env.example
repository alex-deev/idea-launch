# --- Supabase / PostgreSQL ---
# Runtime uses the Transaction pooler (port 6543, pgbouncer=true).
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrations use the Direct connection (port 5432).
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Local alternative (Prisma Dev)
# DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# --- Auth.js v5 ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-strong-random-secret"
AUTH_TRUST_HOST=true

# --- NVIDIA NIM (Nemotron primary provider) ---
# Primary scope/refinement provider. Leave empty to skip and try Gemini.
# Default: Nemotron 3.5 Lightning 30B A3B (fast/efficient).
NVIDIA_API_KEY=""
NVIDIA_MODEL="nvidia/nemotron-3.5-lightning-30b-a3b"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# --- Gemini (fallback provider) ---
# Used when Nemotron fails or is unconfigured. Leave empty to skip.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# --- Payments ---
# true: in-memory mock PaymentIntents/transfers (no Stripe credentials needed)
# false: real Stripe REST calls (requires STRIPE_SECRET_KEY)
USE_MOCK_PAYMENTS=true
MOCK_PAYMENT_FAILURE_RATE=0
STRIPE_SECRET_KEY=""
STRIPE_CONNECTED_ACCOUNT_ID=""
STRIPE_CURRENCY="usd"

# --- Server ---
PORT=3001
CLIENT_ORIGIN="http://localhost:5173"
