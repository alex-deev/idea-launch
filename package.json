{
  "name": "idea-launch",
  "version": "1.0.0",
  "private": true,
  "description": "Idea Launch — project-based development marketplace MVP",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build --workspaces --if-present",
    "db:generate": "npm run prisma:generate -w server",
    "db:migrate": "npm run prisma:migrate -w server",
    "db:seed": "npm run seed -w server",
    "db:studio": "npm run prisma:studio -w server",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "type": "commonjs",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@prisma/client@6.19.3": true,
    "@prisma/client@7.10.1": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true
  },
  "overrides": {
    "@prisma/client": "6.19.3",
    "prisma": "6.19.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
